{
  "name": "keego",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings 209",
    "start": "react-native start",
    "pretest": "node scripts/check-node.js",
    "test": "jest",
    "test:coverage": "jest --config jest.coverage.config.js",
    "test:rules": "JDK21=\"$(scripts/jdk21-home.sh)\" && JAVA_HOME=\"$JDK21\" PATH=\"$JDK21/bin:$PATH\" firebase emulators:exec --only firestore --project keego-rules-test \"jest --config jest.rules.config.js\"",
    "postinstall": "patch-package",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:android:release": "npm run bundle:android && cd android && ./gradlew assembleRelease",
    "install:android:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "e2e": "scripts/e2e.sh",
    "validate-shoes": "tsc -p tsconfig.scripts.json && node node_modules/.cache/keego-scripts/scripts/validate-shoes.js"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/app-check": "^24.0.0",
    "@react-native-firebase/auth": "24.0.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@react-native-firebase/firestore": "24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "@react-native-seoul/naver-login": "^4.2.4",
    "@react-native/new-app-screen": "0.85.2",
    "expo": "~56.0.17",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.0",
    "expo-audio": "~56.0.13",
    "expo-camera": "~56.0.8",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-image-manipulator": "~56.0.23",
    "expo-image-picker": "~56.0.22",
    "expo-keep-awake": "~56.0.3",
    "expo-location": "~56.0.22",
    "expo-media-library": "~56.0.10",
    "expo-notifications": "~56.0.22",
    "expo-sensors": "~56.0.0",
    "expo-sharing": "~56.0.23",
    "expo-task-manager": "~56.0.23",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-health-connect": "^4.1.2",
    "react-native-maps": "^1.27.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-sensors": "^7.3.6",
    "react-native-svg": "^15.15.4",
    "react-native-tts": "^4.1.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^8.19.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.22.4",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
