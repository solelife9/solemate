<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ⚠️ App Group(2026-08-08 추가): 워치 페이스 컴플리케이션이 **다른 프로세스**라 워치 앱의
  UserDefaults.standard 를 읽을 수 없다. 그래서 신발 한 벌을 이 그룹에 공유한다.
  ios/KeegoComplication/KeegoComplication.entitlements 와 **같은 이름**이어야 한다.

  이 그룹은 Apple 개발자 포털에서 워치 앱(com.keego.app.watchkitapp)과
  컴플리케이션(…​.complication) 두 번들 ID 모두에 등록돼야 서명이 통과한다.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.keego.app</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
