rules_version = '2';

// ============================================================================
// Keego Firestore 보안 규칙
// ----------------------------------------------------------------------------
// 아래 세 갈래만 노출한다(그 외 전부 deny):
//   1) userBackups/{uid}/**           — 클라우드 동기 정본(Phase 2). 본인만 읽기/쓰기.
//      하위 컬렉션(runDetails)까지 포함 — 규칙은 상속되지 않으므로 명시했다(아래 주석 참고).
//   2) leaderboards/{ym}/entries/{uid} — 명예의 전당 월간 랭킹(Phase 3). 로그인 사용자는
//      모두 읽기(리더보드 공개), 쓰기는 '자기 uid 문서'만 + 점수 필드 형태 검증(날조 완화).
//   3) races/{raceId}                 — 대회 카탈로그. 읽기 전용(쓰기는 admin SDK 만).
//
// 규칙 회귀는 `npm run test:rules`(에뮬레이터 + @firebase/rules-unit-testing)로 막는다.
// 앱 테스트는 firestore 를 목으로 대체하므로 규칙을 검증하지 못한다 — 반드시 따로 돌린다.
//
// 점수 자체는 클라이언트가 계산하므로 규칙만으로 위조를 100% 막을 수는 없다(서버 재계산이
// 필요하면 Cloud Function 후속). 여기서는 (a) 남의 엔트리 변조 불가, (b) 엔트리 형태 강제로
// 깨진/악성 문서가 리더보드 쿼리를 오염시키지 못하게 하는 것을 보장한다.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 여부.
    function signedIn() {
      return request.auth != null;
    }

    // 들어오는 랭킹 엔트리(request.resource.data)가 규약 형태인지 검증한다.
    // 점수 5종 + updatedAt 은 number, 표시정보는 string, equippedTitle 은 string|null,
    // uid 필드는 반드시 문서 id(=auth uid)와 일치(타인 사칭 차단).
    function validRankingEntry(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && d.nickname is string
        && d.rankTier is string
        && d.rankColor is string
        && (d.equippedTitle == null || d.equippedTitle is string)
        // ── 크기 검증 (2026-08-04) ────────────────────────────────────────────
        // 전에는 `is number` 만 봤다. 점수는 **클라이언트가 계산**하므로, 형태만 통과하면
        // 누구나 distance: 999999 를 써서 영구 1위가 될 수 있었다. 규칙이 리더보드를
        // 공개(2026-08-03)한 뒤로는 그게 실제 노출된 구멍이다.
        //
        // 서버 재계산(Cloud Function)이 진짜 답이지만 그건 큰 작업이고, 그 전에도
        // **사람이 낼 수 없는 값**은 여기서 막을 수 있다. 상한은 인간 기록에 여유를 둔
        // 값이라 정상 사용자는 절대 닿지 않는다:
        //   · distance 1,500km/월 — 세계 최상급 울트라 러너의 월간 주행이 ~1,000km 다.
        //   · consistency 31일 — 한 달의 날 수. 이건 물리적 상한이다.
        //   · shoeHealth 0~100 — 퍼센트다.
        //   · collection 500켤레 — 신발장이 그보다 클 수는 없다.
        //   · progressPoints 10,000 — 총 획득 가능 XP 가 ≈6,310 이다(lib/progression/rank).
        // 음수도 막는다 — 어떤 점수도 음수가 될 수 없는데, 막지 않으면 정렬을 뒤집는
        // 장난이 가능하다.
        && d.distance is number && d.distance >= 0 && d.distance <= 1500
        && d.consistency is number && d.consistency >= 0 && d.consistency <= 31
        && d.shoeHealth is number && d.shoeHealth >= 0 && d.shoeHealth <= 100
        && d.collection is number && d.collection >= 0 && d.collection <= 500
        && d.progressPoints is number && d.progressPoints >= 0 && d.progressPoints <= 10000
        && d.updatedAt is number
        // 닉네임 길이 — 랭킹 행은 좁고, 긴 문자열은 남의 화면까지 늘어뜨린다.
        // profiles 규칙이 이미 40자를 쓰므로 같은 값으로 맞춘다.
        && d.nickname.size() <= 40
        // 신발 요약(선택) — 「1,2,3위는 뭘 신나」. 있으면 형태를 검사한다.
        // 개수 상한을 두는 이유: 엔트리는 랭킹 쿼리로 100개씩 읽히므로, 한 명이 거대한
        // 배열을 심으면 남의 화면까지 느려진다.
        && (!('shoes' in d.keys()) || (d.shoes is list && d.shoes.size() <= 3));
    }

    // ── 클라우드 동기 백업: 본인 서브트리만 ──────────────────────────────────
    // ⚠️ Firestore 규칙은 하위 컬렉션에 상속되지 않는다. `match /userBackups/{uid}` 는
    //    그 *문서 하나*만 허용하므로, 런 상세 사이드카(userBackups/{uid}/runDetails/{runId},
    //    lib/firebaseCloudPort.ts)는 매칭 규칙이 없어 전량 PERMISSION_DENIED 였다
    //    (2026-07-26 출시 심사 B-01 — 재설치 유실 방지 기능이 프로덕션에서 죽어 있었다.
    //    테스트는 firestore 를 목으로 대체하므로 잡히지 않았다 → tests/rules 신설).
    // 하위 경로는 재귀 와일드카드로 한 번에 덮는다. 최소권한은 uid 일치로 이미 보장되고
    // (서브트리 전체가 그 사용자 자신의 데이터), 새 사이드카 컬렉션이 추가돼도 같은
    // 함정에 다시 빠지지 않는다.
    match /userBackups/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── 월간 리더보드: 읽기 전면 차단(2026-07-29 감사) ──────────────────────────
    // 원래는 `allow read: if signedIn()` 이었다 — 로그인한 누구나 전원의 닉네임과 월간
    // 운동량을 읽을 수 있었다. 그런데 그 리더보드를 볼 화면 진입점이 앱에 없었고
    // (App.tsx 가 onOpenHallOfFame 을 주입하지 않는다), 공개된다는 사실을 고지받거나
    // 동의한 사용자도 없었다. 볼 수 없는 기능 때문에 개인정보가 공개돼 있던 상태다.
    //
    // 그래서 읽기를 **본인 것까지 포함해 전부 닫는다.** 발행도 앱에서 꺼져 있으므로
    // (lib/featureFlags.LEADERBOARD_PUBLISH_ENABLED=false) 지금 이 컬렉션은 쓰이지 않는다.
    // 운영 조회는 콘솔/admin SDK 로 한다(규칙 우회).
    //
    // ⚠️ 1.1 재개봉 시: 플래그만 켜면 화면이 아무것도 못 읽는다 — 그게 의도다.
    //    공개 범위 옵트인과 처리방침 제3자 공개 조항을 먼저 만들고, 그때 이 규칙을
    //    동의한 사용자만 노출되도록 다시 설계한다(단순 복원 금지).
    match /leaderboards/{yearMonth}/entries/{uid} {
      // 2026-08-01 재개봉 — 읽기를 로그인 사용자에게 연다.
      // 닫아 뒀던 이유는 "볼 화면도 없는데 동의 없이 쌓이고 있어서"였다. 이제 셋 다 갖췄다:
      //   ① 공개 범위 옵트인(SocialConsentScreen — 동의 전엔 발행 자체가 안 된다)
      //   ② 설정에서 언제든 끌 수 있다(끄면 프로필도 내려간다)
      //   ③ 랭킹 화면 진입점(마이 → 명예의 전당)
      // 앱은 socialVisibility==='public' 일 때만 발행한다(App.publishMyRankingNow).
      // ⚠️ 점수는 여전히 클라이언트 계산이다 — 조작 방지는 서버 재계산(Cloud Function)
      //    으로 별도 처리한다. 규칙이 보장하는 건 '남의 엔트리 변조 불가'와 '형태 강제'다.
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validRankingEntry(uid);
      // 본인 엔트리 삭제는 허용한다(2026-07-29 감사).
      // 원래는 `if false` 였다 — "리더보드 무결성(본인이라도 변조성 삭제 금지)"이 이유였는데,
      // 그 결과 **탈퇴해도 닉네임과 월간 운동량이 영구히 남았다**(deleteAccount 가 지우려
      // 해도 규칙이 막았다). 파기 요건이 순위표 무결성보다 우선한다.
      // 남의 엔트리는 여전히 못 지운다(uid 일치 요구).
      // 순위 조작 우려: 1.1 에서 리더보드를 실제로 노출할 때는 '지우고 다시 쓰기'로
      // 유리한 달을 세탁하는 경로를 서버(Function) 재계산으로 막아야 한다 — 클라이언트
      // 계산 점수를 그대로 신뢰하는 현 구조에서는 삭제 금지만으로 막히지 않았다.
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── 대회 카탈로그(전역, 읽기 전용) ──────────────────────────────────────
    // 마라톤 메달 아카이브의 대회 목록. 큐레이션 데이터라 클라이언트는 읽기만(자동 감지·
    // 대회 선택). 등록/수정은 Firebase 콘솔 또는 관리 스크립트(admin SDK, 규칙 우회)로만.
    match /races/{raceId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── 공개 프로필(소셜 1단계) ─────────────────────────────────────────────
    // 「이 사람은 무슨 러닝화 신나」 — keego 소셜의 첫 조각.
    //
    // **개인 저장소(userBackups)는 절대 열지 않는다.** 여기는 사용자가 공개하기로 한
    // 것만 따로 복사해 올리는 별도 컬렉션이다(2026-08-01 설계 §2.3). keego 는 동의 없이
    // 개인정보가 공개되던 사고를 이미 한 번 냈다(767032e) — 그래서 저장 위치부터 나눈다.
    //
    // 읽기: 로그인 사용자. 인터넷 전체에 여는 것이 아니다(웹은 나중에 별도 판단).
    // 쓰기: **본인만.** 남의 프로필을 만들거나 고칠 수 없다.
    // 삭제: 본인만(공개 중단·탈퇴).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.visibility == 'public'
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 40;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── 앱 원격 설정(전역, 읽기 전용) ───────────────────────────────────────
    // 필수 업데이트 게이트의 최소 지원 버전(AUDIT 2 I-3). races·shoes 와 같은 취급 —
    // 큐레이션 데이터라 클라이언트는 읽기만 하고, 쓰기는 admin SDK 스크립트로만
    // (scripts/seed-config.mjs). 여기가 열리면 누구나 전 사용자의 앱을 잠글 수 있다.
    //
    // 읽기를 `signedIn()` 으로 둔 이유: 이 게이트가 막아야 할 대상은 **이미 설치해 쓰던
    // 사용자**이고 그들은 로그인 상태다. 새로 받는 사람은 애초에 최신 버전을 받는다.
    // 공개 읽기로 열면 '인증 없이 읽히는 컬렉션 0' 이라는 현재 속성이 깨지는데,
    // 그 대가로 얻는 게 없다(2026-07-31 감사 §2 시나리오 4 참조).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── 신발 카탈로그(전역, 읽기 전용) ──────────────────────────────────────
    // races 와 같은 취급 — 큐레이션 데이터라 클라이언트는 읽기만 한다. 카탈로그 쓰기는
    // admin SDK 스크립트로만(services/shoes.ts 의 upsert 계열은 그 전제로 쓴다).
    // 클라이언트 쓰기를 열면 누구나 카탈로그를 오염시킬 수 있다.
    match /shoes/{shoeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── 검색 0건 기록 · 신발 등록 요청 ──────────────────────────────────────
    // 카탈로그가 낡는 문제에 대한 구조적 답이다(docs/shoes-spec.md §6) — 사용자가
    // 찾았는데 없던 것을 데이터로 남긴다. 생성만 허용하고 읽기·수정은 막는다:
    //  · 읽기 금지 — 남의 검색어를 볼 수 있으면 프라이버시 문제다(운영은 콘솔에서 본다).
    //  · 수정·삭제 금지 — 남긴 신호를 지울 수 있으면 신호가 아니다.
    // 형태를 검증해 잡음·거대 문서를 막는다.
    match /search_misses/{docId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        // 계정 식별자는 **받지 않는다**(2026-08-03). 이 컬렉션은 앱이 읽지도 지우지도
        // 못하므로, 남기는 순간 탈퇴해도 지울 수 없는 개인정보가 된다.
        && request.resource.data.keys().hasOnly(['query', 'createdAt'])
        && request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 100;
    }
    match /shoe_requests/{docId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['brand', 'model', 'createdAt', 'source'])
        && request.resource.data.brand is string
        && request.resource.data.model is string
        && request.resource.data.brand.size() <= 60
        && request.resource.data.model.size() <= 60
        // source 는 신호의 출처다(버튼을 눌렀나, 그냥 손으로 넣었나). 자유 문자열로
        // 열어두면 집계가 무의미해지므로 아는 값만 받는다.
        && (!('source' in request.resource.data.keys())
            || request.resource.data.source in ['not_found', 'manual_add']);
    }

    // ── 부적절한 프로필 신고 (App Store 1.2 · 2026-08-07) ──────────────────────
    // 2026-08-03 에 공개 프로필·월간 랭킹을 열면서 이 앱에 **다른 사람이 만든 콘텐츠**
    // (닉네임·러닝화 이름·칭호)가 화면에 뜨기 시작했다. 심사지침 1.2 는 그런 앱에
    // **신고 수단·차단 수단·조치 절차**를 함께 요구한다. 차단은 로컬(서버에 차단 관계를
    // 만들지 않는다 — `lib/social/blockList.ts` 머리말), 신고가 이 컬렉션이다.
    //
    // 위 두 신호 컬렉션과 같은 규약을 따른다:
    //  · **create 만.** 읽기를 열면 "누가 누구를 신고했는지"가 서로에게 보인다 —
    //    그 자체가 사고다. 운영은 콘솔에서 본다.
    //  · **수정·삭제 금지.** 지울 수 있는 신고는 신고가 아니다.
    //  · **자유 입력 텍스트를 받지 않는다.** 사유는 아는 값만 — 자유 서술을 받으면
    //    그게 또 하나의 UGC 가 되고, 무엇이 들어올지 모르는 것을 서버에 쌓게 된다.
    //
    // 신고자 uid 는 **받는다**(search_misses 와 반대). 같은 사람의 반복 신고와 여러 사람의
    // 신고를 구분하지 못하면 조치를 정할 수 없고 악의적 신고도 막을 수 없다 — 목적에
    // 필요한 최소값이라 받고, 처리방침 제2조에 고지했다.
    // 사칭 방지: reporterUid 는 **반드시 본인**이어야 한다(남의 이름으로 신고 불가).
    match /reports/{docId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['targetUid', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetUid.size() <= 128
        // 자기 자신 신고는 조치 대상이 될 수 없고 집계만 더럽힌다.
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in
             ['inappropriate_nickname', 'impersonation', 'offensive_content', 'spam', 'other']
        && request.resource.data.createdAt is number;
    }

    // ── 그 외 전부 거부 ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
