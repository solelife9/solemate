<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 햅틱(진동) — 없으면 RN Vibration.vibrate([pattern]) 이 SecurityException 으로 앱을 죽인다
         (신발 등록 성공 햅틱 등). VIBRATE 는 normal 권한이라 런타임 요청 불필요, 선언만 하면 됨. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── Health Connect (심박) 2026-08-05 ────────────────────────────────────
         안드로이드에는 심박 소스가 없어 평균 심박·심박 존·VO2max 가 전부 비어 있었다.
         Health Connect 는 센서가 아니라 **저장소**다 — 갤럭시워치·가민·핏빗이 여기에 쓰고
         우리는 읽는다. 워치가 없으면 여전히 심박은 없다(아이폰도 애플워치 없으면 없다).
         쓰기 권한은 Keego 러닝을 삼성헬스 등에서도 보이게 하려는 것이다(활동 기록 크레딧). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 백그라운드 런 트래킹(화면off) 권한 — expo-location 의 location 타입 포그라운드
         서비스가 Location.startLocationUpdatesAsync(+foregroundService) 로 기동되므로
         "화면을 꺼도 거리/시간이 계속 기록됨"이 이 두 권한만으로 성립한다.
         Android 14+ 에서 location 타입 포그라운드 서비스 기동에 필수.
         location 타입 <service> 선언은 expo-location 모듈의 매니페스트가 머지하므로
         여기서 중복 선언하지 않는다(중복 선언 시 머지 충돌/크래시 위험).

         ⚠️ ACCESS_BACKGROUND_LOCATION 을 여기 되살리지 마라(2026-08-07 제거).
         이 앱에는 **필요 없다.** expo-location 원본이 명시한다 —
         node_modules/expo-location/.../LocationModule.kt 의 startLocationUpdatesAsync:
           "There are two ways of starting this service.
            1. As a background location service, this requires the background location permission.
            2. As a user-initiated foreground service with notification, this does NOT require
               the background location permission."
         그리고 lib/locationService.ts 는 **항상** foregroundService 를 넘긴다(분기 없음).
         플랫폼 규칙도 같다 — foregroundServiceType="location" 서비스가 도는 동안 앱은
         'in-use' 로 취급되어 while-in-use 권한만으로 위치를 받는다.
         되살리면 Play 의 백그라운드 위치 선언 양식 + **시연 영상 제출**이 다시 붙고,
         온보딩에 수락률이 매우 낮은 '항상 허용' 2단계 다이얼로그가 되돌아온다.
         회귀 가드: __tests__/nativePermissions.test.ts -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- expo-task-manager 필수: 백그라운드 위치 전달을 위해 persisted JobScheduler
         작업(setPersisted(true))을 예약하는데, Android 는 persisted job 예약에
         RECEIVE_BOOT_COMPLETED 권한을 요구한다. 누락 시 첫 백그라운드 위치 수신에서
         LocationTaskConsumer→TaskManagerUtils.scheduleJob 이
         "requested job be persisted without holding RECEIVE_BOOT_COMPLETED permission"
         IllegalArgumentException 으로 크래시한다(화면off 러닝 직후 앱이 바로 종료). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 푸시 알림(Slice 8, @react-native-firebase/messaging). Android 13(API 33)+ 는
         알림 표시에 런타임 권한이 필요하다. messaging.requestPermission() 이 이 권한을
         런타임에 요청하며(lib/pushMessaging.requestPushPermission), 거부돼도 앱은 비차단
         으로 동작한다(S8-3). FCM 서비스(<service> firebase-messaging) 선언은
         @react-native-firebase/messaging 모듈의 매니페스트가 자동 머지하므로 여기서
         중복 선언하지 않는다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── 라이브러리가 끌고 들어온 권한을 걷어낸다 (2026-08-07) ──────────────────
         아래는 **우리가 선언한 적 없는데 머지된 매니페스트에 들어와 있던 것들**이다.
         소스만 읽으면 안 보이고, 사용자에게는 스토어의 '권한' 목록으로 그대로 노출된다.
         확인 방법: android/app/build/intermediates/merged_manifest/release/.../AndroidManifest.xml

         ① 광고 식별자 3종 — Firebase Analytics 가 기본으로 끌고 온다.
            이 앱은 광고를 쓰지 않고 iOS 도 IDFA 미사용(PrivacyInfo NSPrivacyTracking=false)이다.
            **선언돼 있으면 Play 데이터 보안 폼에서 "광고 ID 수집"을 답해야 하고**,
            처리방침에도 없는 식별자가 앱에 붙어 있는 상태가 된다.
            고지를 늘리는 대신 **수집 자체를 끊는 쪽**을 골랐다 — 쓰지 않는 것을 받지 않는다.
            (Firebase 공식 문서가 광고 기능을 안 쓸 때 권장하는 방법이 이 제거다.)

         ② 런처 배지 권한 다수 — 알림 라이브러리(ShortcutBadger 계열)가 끌고 온다.
            삼성·화웨이·오포·HTC·소니 런처의 설정 읽기/쓰기, 바로가기 설치/삭제까지 포함된다.
            **이 앱은 배지를 쓰지 않는다**(setBadgeCount 호출부 0건 — grep 확인).
            남겨두면 스토어 권한 목록에 "바로가기 설치·런처 설정 변경"이 뜨는데,
            러닝 앱이 그걸 요구할 이유를 사용자에게 설명할 수 없다.

         ⚠️ 되살릴 일이 생기면(배지를 실제로 쓰게 되면) 그때 이 블록에서 빼고
            처리방침·데이터 보안 폼을 함께 고칠 것. 회귀 가드: __tests__/nativePermissions.test.ts -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <uses-permission android:name="android.permission.READ_APP_BADGE" tools:node="remove" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" tools:node="remove" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" tools:node="remove" />
    <uses-permission android:name="com.android.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.android.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.anddoes.launcher.permission.UPDATE_COUNT" tools:node="remove" />
    <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.htc.launcher.permission.UPDATE_SHORTCUT" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE" tools:node="remove" />
    <uses-permission android:name="com.oppo.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.oppo.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" tools:node="remove" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" tools:node="remove" />
    <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE" tools:node="remove" />
    <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE" tools:node="remove" />
    <uses-permission android:name="me.everything.badger.permission.BADGE_COUNT_READ" tools:node="remove" />
    <uses-permission android:name="me.everything.badger.permission.BADGE_COUNT_WRITE" tools:node="remove" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!-- ── 알림 아이콘 (2026-08-07) ─────────────────────────────────────────
           안드로이드 5.0+ 는 상태바 아이콘을 **알파 채널만** 써서 실루엣으로 그린다.
           지정이 없으면 컬러 앱 아이콘이 뭉개져 **흰 사각형**이 뜬다 — 지정 전까지
           이 앱의 모든 알림(러닝 리마인더·잠금화면 러닝·교체 임박)이 그 상태였다.
           아이콘은 브랜드 서명인 열린 링(@drawable/ic_notification),
           강조색은 Keego Ember(RING_ACCENT #FF8000 — theme.ts 와 같은 값).
           회귀 가드: __tests__/androidManifestHygiene.test.ts -->
      <meta-data
        android:name="expo.modules.notifications.default_notification_icon"
        android:resource="@drawable/ic_notification" />
      <meta-data
        android:name="expo.modules.notifications.default_notification_color"
        android:resource="@color/notification_accent" />
      <!-- location 타입 포그라운드 서비스(<service ... foregroundServiceType="location">)
           는 expo-location 모듈의 AndroidManifest 가 자동 머지하므로 여기서 직접
           선언하지 않는다(중복 선언 시 머지 충돌). -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Health Connect 권한 창의 '개인정보 처리방침' 링크가 여기로 온다(안드로이드 13 이하).
             이 필터가 없으면 권한 창에서 링크가 죽고, 구글 정책상 심박 권한 심사에서 걸린다.
             안드로이드 14+ 는 아래 activity-alias 가 같은 역할을 한다. -->
        <intent-filter>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent-filter>
      </activity>

      <!-- Health Connect 권한 근거 화면(안드로이드 14+). 시스템만 띄울 수 있도록
           START_VIEW_PERMISSION_USAGE 로 잠근다 — 아무 앱이나 우리 화면을 열지 못한다. -->
      <activity-alias
        android:name="ViewPermissionUsageActivity"
        android:exported="true"
        android:targetActivity=".MainActivity"
        android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
        <intent-filter>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent-filter>
      </activity-alias>

      <!-- Google Maps API 키 — react-native-maps 지도 표시에 필요.
           Google Cloud Console → Maps SDK for Android → API 키 생성 후 입력. -->
      <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="AIzaSyAMV_3gLfZn2qf1w7Ck-9eb0uFJbu-_FEY"/>

      <!-- 카카오 로그인 redirect 핸들러. scheme 의 앱 키는 build.gradle 의
           manifestPlaceholder(kakaoNativeAppKey, ~/.gradle 에서 주입)로 채워진다
           — 공개 저장소에 키를 두지 않기 위함. 키 미설정 시 scheme=kakao 로 무해. -->
      <activity
        android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:host="oauth" android:scheme="kakao${kakaoNativeAppKey}" />
        </intent-filter>
      </activity>

      <!-- 홈 화면 위젯(활성 러닝화 수명 링). iOS KeegoShoeWidget 의 안드로이드 대응물.
           데이터는 KeegoWidgetModule 이 SharedPreferences 에 쓰고, 앱이 신발을 바꿀 때
           즉시 갱신을 건다(updatePeriodMillis 는 앱을 오래 안 열었을 때의 폴백). -->
      <receiver
        android:name=".ShoeWidgetProvider"
        android:exported="false">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/shoe_widget_info" />
      </receiver>
    </application>
</manifest>
