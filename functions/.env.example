# functions/.env.example — 실제 키는 functions/.env 에 넣는다(그 파일은 gitignore 됨).
#
# 배포:  firebase deploy --only functions
#   (firebase-tools 가 functions/.env 를 읽어 런타임 환경변수로 주입한다.)
#
# 키가 없으면 관련 기능이 조용히 꺼진다 — 앱은 멀쩡하고 그 칸만 빈다.

# ── 소셜 로그인(카카오) ────────────────────────────────────────────────────────
# 카카오 개발자센터 > 내 애플리케이션 > 앱 설정 > 요약 정보의 **앱 ID(숫자)**.
# 미설정 시 카카오 로그인은 503 으로 거부된다(fail-closed — 이게 없으면 다른 앱에서
# 발급된 토큰으로도 우리 계정을 열 수 있다).
KAKAO_APP_ID=

# ── 러닝화 현재가 조회(네이버 검색 API) ─────────────────────────────────────────
# https://developers.naver.com > Application > 애플리케이션 등록
#   · 사용 API: **검색**
#   · 환경 추가: WEB 설정 → 서비스 URL 아무거나(예: https://keego.app)
# 등록하면 나오는 Client ID / Client Secret 을 그대로 붙인다.
# 미설정 시 /shop/price 가 503 + 빈 목록을 돌려주고, 앱은 가격·원/km 칸만 비운다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── 남용 방지(선택) ───────────────────────────────────────────────────────────
# IP당 윈도 내 최대 요청수 / 윈도 길이(ms). 비우면 기본값 20회 / 60초.
AUTH_RATE_MAX=
AUTH_RATE_WINDOW_MS=
